# Build artifacts
target/
# The dashboard bundle is built deterministically in the `frontend`
# Docker stage (Node 20 → vite 6), so a developer's local build artifacts must
# not leak into the image context. dist comes only from that stage.
crates/dataglot-server/frontend/node_modules/
crates/dataglot-server/frontend/dist/
*.rlib
*.rmeta

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Documentation (not needed in image)
*.md
!README.md
# THIRD_PARTY_LICENSES.md is generated by `cargo-about` and must
# ship in the production image per Apache-2.0 § 4(d) attribution;
# whitelist it past the *.md exclusion. See Dockerfile.
!THIRD_PARTY_LICENSES.md
docs/

# Test files (not needed in production image)
testdata/
tests/
dataglot-tests/

# CI/CD configs
.github/
.gitlab-ci.yml
.travis.yml

# Local configs
*.local.*
.env*
config/*.local.json

# Misc
Makefile
deny.toml
rustfmt.toml
taplo.toml
.cargo/
